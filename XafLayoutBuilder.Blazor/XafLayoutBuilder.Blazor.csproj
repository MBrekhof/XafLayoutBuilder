<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Blazor add-on for XafLayoutBuilder: Copy Layout To Clipboard and Download Layout File. The Module stays platform neutral.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.ExpressApp.Blazor" Version="$(DevExpressPackageRange)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XafLayoutBuilder.Module\XafLayoutBuilder.Module.csproj" />
  </ItemGroup>
</Project>
