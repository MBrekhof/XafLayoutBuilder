@* The running application's model as a tree, and the selected node's values grouped by category, the way the WinForms
   Model Editor shows them (docs/model-editor-scope.md). Value edits, deletes and node resets stay pending in the session
   until Save, which writes them to the current user's differences (the model's writable layer) and persists them through
   XafApplication.SaveModelChanges. Added and cloned nodes exist at once so their values can be edited; closing the popup
   without Save drops the pending edits and removes those nodes (ModelEditorController). *@

@if (!allowed) {
    <p class="xlb-model-editor-denied">Your role may not edit the application model.</p>
}
else {
    <div class="xlb-model-editor" style="display:flex; gap:1rem; height:65vh; font-size:0.875rem">
        <div style="flex:0 0 40%; display:flex; flex-direction:column; min-width:0">
            @* MODELEDITOR-003 review: DevExpress Blazor editors and buttons throughout, so the editor looks like the rest of XAF.
               The search runs as you type; the class stays on the input, where the gate fills it. *@
            <DxSearchBox InputCssClass="xlb-model-search" NullText="Search the model" style="margin-bottom:0.5rem"
                         Text="@searchText" TextChanged="@((string value) => SearchTextChanged(value))"
                         BindValueMode="BindValueMode.OnDelayedInput" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            @if (searchResults is not null) {
                <ul class="xlb-model-search-results" style="overflow:auto; list-style:none; padding-left:0; margin:0">
                    @if (searchResults.Count == 0) {
                        <li>No node matches.</li>
                    }
                    @foreach (var result in searchResults) {
                        <li data-result="@ModelEditing.Path(result)" style="cursor:pointer; white-space:nowrap" @onclick="() => Reveal(result)">
                            @ModelEditing.Path(result)
                        </li>
                    }
                </ul>
            }
            else {
                <ul class="xlb-model-tree" style="overflow:auto; list-style:none; padding-left:0; margin:0">
                    @foreach (var child in ModelEditing.Children(Application.Model)) {
                        @TreeNode(child)
                    }
                </ul>
            }
        </div>
        <div class="xlb-model-values" style="flex:1; overflow:auto; display:flex; flex-direction:column">
            @* MODELEDITOR-008: the language localizable values are read and written in (ModelEditSession.Aspect), a language to
               add, and the translate view over the selected node. Reads and writes are scoped on the thread (ModelEditing.Aspect),
               so the rest of the circuit keeps its own language. *@
            <div class="xlb-language-bar" style="display:flex; flex-wrap:wrap; gap:0.25rem; align-items:center; margin-bottom:0.5rem">
                <span>Language</span>
                <span class="xlb-language">
                    <DxComboBox TData="AspectItem" TValue="string" Data="@AspectItems()" ValueFieldName="Value" TextFieldName="Text"
                                Value="@Aspect" ValueChanged="@((string value) => SetAspect(value))" style="width:11em" />
                </span>
                <DxTextBox InputCssClass="xlb-new-language" NullText="Add a language (nl-NL)" style="width:12em" @bind-Text="newLanguage" />
                <DxButton CssClass="xlb-add-language" Text="Add" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" Click="AddLanguage" />
                @if (selected is not null && Aspect.Length > 0) {
                    <DxButton CssClass="xlb-translate" Text="@(translating ? "Values" : "Translate")" title="Every localizable value under the node, with its translation"
                              RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" Click="() => translating = !translating" />
                }
            </div>
            @if (selected is null || !ModelEditing.IsInModel(selected)) {
                <p>Select a node.</p>
            }
            else {
                @* The node's path and actions stay at the top of the panel while its values scroll (MODELEDITOR-003 review). *@
                <div class="xlb-node-header" style="position:sticky; top:0; z-index:2; background:Canvas; padding-bottom:0.25rem">
                <div data-selected="@ModelEditing.Path(selected)" style="font-weight:600; margin-bottom:0.5rem">@ModelEditing.Path(selected)</div>
                <div class="xlb-node-actions" style="display:flex; flex-wrap:wrap; gap:0.25rem; align-items:center; margin-bottom:0.5rem">
                    <DxButton CssClass="xlb-back" Text="Back" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(historyAt > 0)" Click="() => StepHistory(-1)" />
                    <DxButton CssClass="xlb-forward" Text="Forward" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(historyAt < history.Count - 1)" Click="() => StepHistory(1)" />
                    @{ var creatable = ModelEditing.CreatableTypes(selected); }
                    @if (creatable.Count > 0) {
                        <span class="xlb-new-type">
                            <DxComboBox TData="string" TValue="string" Data="@creatable.Keys.Order(StringComparer.Ordinal).ToList()"
                                        @bind-Value="newNodeType" NullText="Add a child of type" style="width:13em" />
                        </span>
                    }
                    <DxTextBox InputCssClass="xlb-new-id" NullText="New node id" style="width:10em" @bind-Text="newNodeId" />
                    @if (creatable.Count > 0) {
                        <DxButton CssClass="xlb-add" Text="Add" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" Click="AddNode" />
                    }
                    @if (ModelEditing.CanClone(selected)) {
                        <DxButton CssClass="xlb-clone" Text="Clone" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" Click="CloneNode" />
                    }
                    @if (ModelEditing.CanDelete(selected)) {
                        <DxButton CssClass="xlb-delete" Text="@(Session.IsPendingDelete(selected) ? "Keep" : "Delete")"
                                  RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" Click="ToggleDelete" />
                    }
                    @if (selected.Parent is not null) {
                        <DxButton CssClass="xlb-up" Text="Up" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" Click="() => Move(true)" />
                        <DxButton CssClass="xlb-down" Text="Down" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" Click="() => Move(false)" />
                    }
                    @if (ModelEditing.IsModified(selected) && Session.CanResetNode(selected)) {
                        <DxButton CssClass="xlb-reset-node" Text="@(Session.IsPendingNodeReset(selected) ? "Reset on save" : "Reset node")"
                                  RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" Click="ResetNode" />
                    }
                </div>
                </div>
                var missingRequired = Session.MissingRequired(selected);
                @if (translating && Aspect.Length > 0) {
                    @* MODELEDITOR-008: the WinForms Localization window as a table: node, value, the default language's text and
                       the language's text to edit; edits are pending like the value grid's. *@
                    <div style="margin-bottom:0.25rem">
                        <DxCheckBox CssClass="xlb-untranslated-only" @bind-Checked="untranslatedOnly">Untranslated only</DxCheckBox>
                    </div>
                    <table class="xlb-localization" data-aspect="@Aspect" style="width:100%; border-collapse:collapse; table-layout:fixed">
                        <colgroup><col style="width:30%" /><col style="width:16%" /><col /><col /><col style="width:6em" /></colgroup>
                        <tr style="font-weight:600; opacity:0.7"><td style="padding:2px 6px">Node</td><td style="padding:2px 6px">Value</td><td style="padding:2px 6px">Default</td><td style="padding:2px 6px">@Aspect</td><td></td></tr>
                        @foreach (var row in LocalizationRows()) {
                            var pending = Session.TryGetPending(row.Node, row.Name, out var pendingText, out var pendingError);
                            var text = pending ? pendingText ?? "" : row.TranslatedText;
                            <tr @key="(ModelEditing.Path(row.Node), row.Name, refusals)" data-translate="@(ModelEditing.Path(row.Node) + "|" + row.Name)" style="border-bottom:1px solid rgba(128,128,128,0.2)">
                                <td style="padding:2px 6px; overflow-wrap:anywhere"><span style="cursor:pointer" title="Open the node" @onclick="() => Reveal(row.Node)">@ModelEditing.Path(row.Node)</span></td>
                                <td style="padding:2px 6px; overflow-wrap:anywhere">@row.Name</td>
                                <td style="padding:2px 6px; overflow-wrap:anywhere">@row.DefaultText</td>
                                <td style="padding:2px 6px">
                                    <DxTextBox Text="@text" TextChanged="@((string value) => Translate(row.Node, row.Name, value))" style="width:100%" />
                                </td>
                                <td style="padding:2px 6px; white-space:nowrap">
                                    @if (pendingError is not null) {
                                        <span class="xlb-invalid" title="@pendingError" style="color:#c00">invalid</span>
                                    }
                                    else if (pending) {
                                        <span class="xlb-pending">@(pendingText is null ? "reset on save" : "unsaved")</span>
                                    }
                                    else if (row.IsTranslated) {
                                        <span class="xlb-translated" style="opacity:0.7">translated</span>
                                    }
                                </td>
                            </tr>
                        }
                    </table>
                }
                else {
                @* Fixed layout: a long read-only value, such as a node path, wraps instead of widening the table past the panel, where
                   the editors were clipped (MODELEDITOR-003 review). *@
                @* data-aspect: the language the rows were rendered in, which the gate waits for after switching. *@
                <table class="xlb-values" data-aspect="@Aspect" style="width:100%; border-collapse:collapse; table-layout:fixed">
                    <colgroup><col style="width:38%" /><col /><col style="width:7.5em" /></colgroup>
                    @foreach (var group in ValueRows().GroupBy(r => r.Category ?? "Misc").OrderBy(g => g.Key, StringComparer.Ordinal)) {
                        <tr class="xlb-category"><td colspan="3" style="padding:6px 6px 2px; font-weight:600; opacity:0.7">@group.Key</td></tr>
                        @foreach (var row in group) {
                            var pending = Session.TryGetPending(selected, row.Name, out var pendingText, out var pendingError);
                            var text = pending ? pendingText ?? "" : row.Text;
                            @* Keyed with the refusal count: the controls are not bound, so a refused edit recreates them from the
                               session and the model instead of leaving the refused text on screen (Codex review 5). The language
                               too: its texts differ per language (MODELEDITOR-008). *@
                            <tr @key="(row.Name, refusals, Aspect)" data-value="@row.Name" style="border-bottom:1px solid rgba(128,128,128,0.2)">
                                <td style="padding:2px 6px; overflow-wrap:anywhere">
                                    <span class="xlb-value-name" style="cursor:pointer; font-weight:@(row.IsModified ? "600" : "normal")"
                                          @onclick="() => focusedDescription = row.Description">@row.Name</span>
                                    @if (row.IsRequired) {
                                        <span title="Required" style="color:#c00">*</span>
                                    }
                                    @if (row.IsLocalizable) {
                                        <span title="Localizable: stored per language" style="opacity:0.6">(L)</span>
                                    }
                                    @if (typeof(IModelNode).IsAssignableFrom(row.Type) && Session.Referenced(selected, row.Name) is { } target) {
                                        <DxButton CssClass="xlb-goto" Text="Go to" title="Open the node this value refers to"
                                                  RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Text" Click="() => Reveal(target)" />
                                    }
                                    @if (ModelEditing.ValueSource(selected, row.Name) is { } source) {
                                        <DxButton CssClass="xlb-source" Text="Source" title="Open the value this one is calculated from"
                                                  RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Text"
                                                  Click="() => GoToSource(source.Node, source.Name)" />
                                    }
                                </td>
                                <td style="padding:2px 6px; overflow-wrap:anywhere">
                                    @if (!row.CanEdit) {
                                        <span title="@row.ReadOnlyMessage">@row.Text</span>
                                    }
                                    else if (row.Choices is { } choices) {
                                        @* An optional value clears with the clear button, which stores none, as the old empty option did. *@
                                        <DxComboBox TData="string" TValue="string" Data="@choices" Value="@(text.Length == 0 ? null : text)"
                                                    ValueChanged="@((string? value) => Set(row.Name, value))" style="width:100%"
                                                    ClearButtonDisplayMode="@(row.IsRequired ? DataEditorClearButtonDisplayMode.Never : DataEditorClearButtonDisplayMode.Auto)" />
                                    }
                                    else if (row.Editor is ModelValueEditor.Multiline or ModelValueEditor.Expression) {
                                        @* MODELEDITOR-006: multiline strings and expressions. DevExpress Blazor has no expression editor; the text is free. *@
                                        <DxMemo Text="@text" TextChanged="@((string value) => Set(row.Name, value))" Rows="3" style="width:100%" />
                                    }
                                    else {
                                        <div style="display:flex; gap:0.25rem; align-items:center">
                                            @if (row.Suggestions is { } suggestions) {
                                                @* Field names, languages and image names are offered, other text is still accepted: typed text that is no
                                                   item arrives through TextChanged. Virtual, because image names run into the thousands. *@
                                                <DxComboBox TData="string" TValue="string" Data="@suggestions" AllowUserInput="true" ListRenderMode="ListRenderMode.Virtual"
                                                            Text="@text" TextChanged="@((string value) => Set(row.Name, value))" style="flex:1; min-width:0" />
                                            }
                                            else {
                                                <DxTextBox Text="@text" TextChanged="@((string value) => Set(row.Name, value))" style="flex:1; min-width:0" />
                                            }
                                            @if (row.Editor == ModelValueEditor.Criteria) {
                                                <DxButton CssClass="xlb-criteria-builder" Text="Filter builder" title="Edit the criteria in the filter builder"
                                                          RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Text"
                                                          Click="() => OpenCriteria(row.Name, text)" />
                                            }
                                            @if (row.Editor == ModelValueEditor.Image && ImageUrl(text) is { } imageUrl) {
                                                <img class="xlb-image-preview" src="@imageUrl" alt="" style="height:1.25em" />
                                            }
                                        </div>
                                    }
                                </td>
                                <td style="padding:2px 6px; white-space:nowrap">
                                    @* MODELEDITOR-007: a required value the node lacks once the pending edits are written. *@
                                    @if (missingRequired.Contains(row.Name)) {
                                        <span class="xlb-required-missing" title="A value is required" style="color:#c00; margin-right:0.25rem">required</span>
                                    }
                                    @if (pendingError is not null) {
                                        <span class="xlb-invalid" title="@pendingError" style="color:#c00">invalid</span>
                                    }
                                    else if (pending) {
                                        <span class="xlb-pending">@(pendingText is null ? "reset on save" : "unsaved")</span>
                                    }
                                    else if (row.IsModified) {
                                        <DxButton CssClass="xlb-reset" Text="Reset" RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Text"
                                                  Click="() => Reset(row.Name)" />
                                    }
                                </td>
                            </tr>
                        }
                    }
                </table>
                }
                @* MODELEDITOR-006: XAF Blazor edits criteria with DxFilterBuilder (CriteriaPropertyEditor); the fields are the filtered type's
                   members as its criteria editor lists them. Apply writes the builder's criteria back as text. *@
                @if (criteriaName is not null && ModelEditing.CriteriaTypeInfo(selected, criteriaName) is { } criteriaType) {
                    @* Keyed per opening: a reused DxFilterBuilder keeps an invalid draft when the criteria it is given do not change,
                       null for two empty values (Codex review 2). *@
                    <div @key="(criteriaName, criteriaOpenings)" class="xlb-filter-builder" style="margin-top:0.5rem; padding-top:0.5rem; border-top:1px solid rgba(128,128,128,0.3)">
                        <div style="font-weight:600; margin-bottom:0.25rem">@criteriaName: @criteriaType.Name</div>
                        <DxFilterBuilder @ref="filterBuilderRef" @bind-FilterCriteria="criteria" ViewMode="FilterBuilderViewMode.VisualAndText"
                                         Fields="@FilterFieldsFragment(ModelEditing.FilterFields(criteriaType))" />
                        <div style="margin-top:0.25rem">
                            <DxButton CssClass="xlb-criteria-apply" Text="Apply" RenderStyle="ButtonRenderStyle.Primary" Click="ApplyCriteria" />
                            <DxButton CssClass="xlb-criteria-cancel" Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline"
                                      Click="() => criteriaName = null" />
                        </div>
                    </div>
                }
                @* DevExpress builds the descriptions from type names and [Description] attributes, with <b> and <br>; everything
                   else is encoded, generic type arguments included. *@
                <div class="xlb-description" style="margin-top:0.5rem; padding:0.5rem; border-top:1px solid rgba(128,128,128,0.3); opacity:0.85">
                    @((MarkupString)ModelEditing.DescriptionHtml(focusedDescription ?? ModelEditing.NodeDescription(selected)))
                </div>
            }
            <div style="margin-top:0.75rem">
                <DxButton CssClass="xlb-save" Text="Save" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!Session.HasErrors)" Click="Save" />
                <span class="xlb-model-editor-message" style="margin-left:0.5rem">@message</span>
            </div>
        </div>
    </div>
}

@inject NavigationManager Navigation
@inject DevExpress.ExpressApp.Blazor.Services.IImageUrlService ImageUrls

@code {
    [Parameter] public XafApplication Application { get; set; } = null!;
    [Parameter] public ModelEditSession Session { get; set; } = null!;
    [Parameter] public string? StartViewId { get; set; }

    // By path: the node instances Parent returns are not the tree's own (ModelEditing.IsInModel).
    readonly HashSet<string> expanded = [];
    // Back and Forward walk the nodes selected before, as in the WinForms editor (docs/model-editor-scope.md, navigation).
    readonly List<IModelNode> history = [];
    int historyAt = -1;
    IModelNode? selected;
    string? focusedDescription;
    string? message;
    string searchText = "";
    IReadOnlyList<IModelNode>? searchResults;
    string newNodeId = "";
    string? newNodeType;
    bool allowed;
    // Actions Run refused; part of the value rows' @key.
    int refusals;
    // MODELEDITOR-006: the criteria value open in the filter builder, and the criteria the builder holds.
    string? criteriaName;
    CriteriaOperator? criteria;
    DxFilterBuilder? filterBuilderRef;
    int criteriaOpenings;
    bool unusableWarned;
    // MODELEDITOR-008: the translate view over the selected node, its filter, and a language to add.
    bool translating;
    bool untranslatedOnly;
    string newLanguage = "";

    sealed record AspectItem(string Value, string Text);

    // The editor's language: the session's, or the model's own until one is chosen.
    string Aspect => Session.Aspect ?? ModelEditing.CurrentAspect(Application.Model);

    List<AspectItem> AspectItems() => ModelEditing.Aspects(Application.Model).Select(a => new AspectItem(a, a.Length == 0 ? "(default)" : a)).ToList();

    void SetAspect(string value) {
        Session.Aspect = value;
        translating &= value.Length > 0;
    }

    void AddLanguage() => Run(() => {
        var language = newLanguage.Trim();
        if (language.Length == 0) throw new InvalidOperationException("Give the language's culture name, nl-NL for example.");
        Session.Aspect = ModelEditing.AddAspect(Application.Model, language);
        newLanguage = "";
    }, "Language added; it is stored with its first saved value");

    // The selected node's values in the editor's language.
    IReadOnlyList<ModelValueRow> ValueRows() {
        using (ModelEditing.Aspect(selected!, Session.Aspect)) return ModelEditing.Values(selected!);
    }

    // A pending edit counts as translated, so the filter does not hide what was just typed.
    IEnumerable<LocalizationRow> LocalizationRows() =>
        ModelEditing.LocalizableValues(selected!, Aspect).Where(r => !untranslatedOnly || !r.IsTranslated || Session.TryGetPending(r.Node, r.Name, out _, out _));

    void Translate(IModelNode node, string name, string text) => Run(() => Session.SetText(node, name, text), null);

    // Checked here as well as on the action: the component must not trust how it was reached.
    protected override void OnParametersSet() => allowed = ModelEditorController.CanEditModel(Application);

    // View in Model: open on the node of the view the action ran in. After the first render, not in OnInitialized: with the
    // node's values already rendered as the popup opened, focus ended up in the last value editor and the panel scrolled to
    // the bottom, while selecting a node later leaves focus in the search box (MODELEDITOR-003 review, measured in the sample).
    protected override void OnAfterRender(bool firstRender) {
        if (!firstRender || StartViewId is null || Application.Model.Views[StartViewId] is not { } view) return;
        Reveal(view);
        StateHasChanged();
    }

    // Captions from [DisplayProperty], modified nodes in bold as in the WinForms tree, an expand button only for node types
    // that can have children. Added nodes are in italics, nodes to be deleted struck through.
    RenderFragment TreeNode(IModelNode node) => @<li style="white-space:nowrap">
        @if (ModelEditing.CanHaveChildren(node)) {
            <DxButton data-expand="@ModelEditing.Path(node)" Text="@(expanded.Contains(ModelEditing.Path(node)) ? "-" : "+")"
                      RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Text" style="min-width:1.75em; padding:0 0.25em"
                      Click="() => Toggle(node)" />
        }
        else {
            <span style="display:inline-block; width:1.75em"></span>
        }
        <span data-node="@ModelEditing.Path(node)" class="@(ModelEditing.IsModified(node) ? "xlb-modified" : null)"
              style="cursor:pointer; padding:0 2px; font-weight:@(ModelEditing.IsModified(node) ? "600" : "normal"); font-style:@(Session.IsAdded(node) ? "italic" : "normal"); text-decoration:@(Session.IsPendingDelete(node) ? "line-through" : "none"); background:@(ReferenceEquals(node, selected) ? "rgba(128,128,128,0.25)" : "transparent")"
              @onclick="() => Select(node)">@if (ImageUrl(ModelEditing.ImageName(node)) is { } icon) {<img class="xlb-node-icon" src="@icon" alt="" style="height:1em; vertical-align:text-bottom; margin-right:0.25em" />}@ModelEditing.Caption(node)</span>
        @if (expanded.Contains(ModelEditing.Path(node))) {
            <ul style="list-style:none; padding-left:1.25em; margin:0">
                @foreach (var child in ModelEditing.Children(node)) {
                    @TreeNode(child)
                }
            </ul>
        }
    </li>;

    void Toggle(IModelNode node) {
        var path = ModelEditing.Path(node);
        if (!expanded.Remove(path)) expanded.Add(path);
    }

    // MODELEDITOR-007: leaving a node that lacks required values says so. ponytail: the WinForms editor refuses the node change
    // (ModelEditorViewController.cs 1351); here Save refuses, listing every node, so moving around the tree stays free.
    void Select(IModelNode node) {
        var left = selected is not null && ModelEditing.IsInModel(selected) ? Session.MissingRequired(selected) : [];
        var leftPath = selected is null ? null : ModelEditing.Path(selected);
        history.RemoveRange(historyAt + 1, history.Count - historyAt - 1);
        history.Add(node);
        historyAt = history.Count - 1;
        Show(node);
        if (left.Count > 0) message = $"{leftPath}: {string.Join(", ", left)} required";
    }

    void Show(IModelNode node) {
        selected = node;
        focusedDescription = null;
        message = null;
        criteriaName = null;
    }

    // A node removed since is skipped.
    void StepHistory(int direction) {
        for (var at = historyAt + direction; at >= 0 && at < history.Count; at += direction) {
            if (!ModelEditing.IsInModel(history[at])) continue;
            historyAt = at;
            Show(history[at]);
            return;
        }
    }

    // Source: open the node a calculated value comes from, with that value's description.
    void GoToSource(IModelNode node, string name) {
        Reveal(node);
        focusedDescription = ModelEditing.Values(node).FirstOrDefault(r => r.Name == name)?.Description;
    }

    void RunSearch() => Run(() => searchResults = string.IsNullOrWhiteSpace(searchText) ? null : ModelEditing.Search(Application.Model, searchText), null);

    void SearchTextChanged(string text) {
        searchText = text;
        RunSearch();
    }

    // Picking a search result opens the tree down to it and selects it.
    void Reveal(IModelNode node) {
        for (var parent = node.Parent; parent is not null; parent = parent.Parent) expanded.Add(ModelEditing.Path(parent));
        searchText = "";
        searchResults = null;
        Select(node);
    }

    void Set(string name, string? text) => Run(() => Session.SetText(selected!, name, text ?? ""), null);

    void Reset(string name) => Run(() => Session.Reset(selected!, name), null);

    // The text is parsed as XAF's criteria editor parses it, inside an object space's parse scope (DxFilterBuilderAdapter.SetValue).
    void OpenCriteria(string name, string text) => Run(() => {
        var typeInfo = ModelEditing.CriteriaTypeInfo(selected!, name)
            ?? throw new InvalidOperationException($"{name} filters no type yet; set the value it names first.");
        using var objectSpace = Application.CreateObjectSpace(typeInfo.Type);
        using (objectSpace.CreateParseCriteriaScope()) criteria = CriteriaOperator.Parse(text);
        criteriaName = name;
        criteriaOpenings++;
    }, null);

    // As DxFilterBuilderAdapter.GetValue: the criteria's text. The builder keeps its last valid FilterCriteria while its text
    // is invalid, so Apply waits for the builder's validation (DxFilterBuilder.GetEditContext) and leaves the text open for
    // correction (Codex review). A refused edit leaves the grid's value and says why.
    void ApplyCriteria() {
        if (filterBuilderRef?.GetEditContext().GetValidationMessages().ToList() is { Count: > 0 } errors) {
            message = "Correct the criteria first: " + string.Join(" ", errors);
            return;
        }
        var name = criteriaName!;
        criteriaName = null;
        Set(name, criteria?.ToString() ?? "");
    }

    // A reference with nested fields is only a way to reach them, as the DxFilterBuilder docs nest references.
    RenderFragment FilterFieldsFragment(IReadOnlyList<FilterField> fields) => builder => {
        foreach (var field in fields) {
            builder.OpenComponent<DxFilterBuilderField>(0);
            builder.SetKey(field.FieldName);
            builder.AddAttribute(1, nameof(DxFilterBuilderField.FieldName), field.FieldName);
            builder.AddAttribute(2, nameof(DxFilterBuilderField.Caption), field.Caption);
            builder.AddAttribute(3, nameof(DxFilterBuilderField.Type), field.Type);
            builder.AddAttribute(4, nameof(DxFilterBuilderField.IsCollection), field.IsCollection);
            if (field.Fields.Count > 0) {
                builder.AddAttribute(5, nameof(DxFilterBuilderField.AllowSelection), field.IsCollection);
                builder.AddAttribute(6, nameof(DxFilterBuilderField.Fields), FilterFieldsFragment(field.Fields));
            }
            builder.CloseComponent();
        }
    };

    // An image name the application does not know shows no image: XAF Blazor gives an empty URL for it (ImageUrlService.GetImageUrl,
    // IImageUrlService.cs 58-78).
    string? ImageUrl(string imageName) {
        if (string.IsNullOrEmpty(imageName)) return null;
        try {
            return ImageUrls.GetImageUrl(imageName) is { Length: > 0 } url ? url : null;
        }
        catch (Exception) {
            return null;
        }
    }

    // MODELEDITOR-004: node operations.
    void AddNode() => Run(() => {
        var parent = selected!;
        if (string.IsNullOrEmpty(newNodeType) || !ModelEditing.CreatableTypes(parent).TryGetValue(newNodeType, out var type))
            throw new InvalidOperationException("Choose the type of node to add.");
        var node = Session.AddChild(parent, type, NewId());
        expanded.Add(ModelEditing.Path(parent));
        Select(node);
    }, null);

    void CloneNode() => Run(() => Select(Session.Clone(selected!, NewId())), null);

    string NewId() {
        if (string.IsNullOrWhiteSpace(newNodeId)) throw new InvalidOperationException("Give the new node an id.");
        var id = newNodeId.Trim();
        newNodeId = "";
        return id;
    }

    void ToggleDelete() => Run(() => Session.Delete(selected!, !Session.IsPendingDelete(selected!)), null);

    // Up/Down becomes Index edits renumbering the shown siblings (ModelEditSession.Move).
    void Move(bool up) => Run(() => Session.Move(selected!, up), null);

    void ResetNode() => Run(() => Session.ResetNode(selected!), null);

    // MODELEDITOR-002: XAF Blazor's warmed-up model caches values and ClearValue does not refresh that cache, and views
    // already created keep the model they were built from. So Save reloads the page, as the WinForms editor restarts every
    // window (WinApplication.EditModel): the new circuit builds its model again from the differences just saved.
    void Save() => Run(() => {
        // MODELEDITOR-007: stored differences the model can no longer use are dropped by this save (the database store writes
        // only the usable layer), so the first Save says so and the next one goes ahead.
        if (!unusableWarned && ModelEditing.HasUnusableDifferences((DevExpress.ExpressApp.Model.Core.ModelApplicationBase)Application.Model)) {
            unusableWarned = true;
            throw new InvalidOperationException("Your stored model differences hold nodes the model no longer has (after a module or version change, " +
                "for example). They are not applied, and saving rewrites your differences without them. Press Save again to go ahead.");
        }
        // The database store keeps an aspect whose differences became empty; without the cleanup a reset localized caption
        // returns. Only the aspects these edits emptied are blanked, and the session keeps them until that succeeded.
        Session.Apply(((DevExpress.ExpressApp.Model.Core.ModelApplicationBase)Application.Model).LastLayer);
        // Before any other model save ModelEditorController removes the nodes added here; this one keeps them.
        Session.Saving = true;
        try {
            Application.SaveModelChanges();
        }
        finally {
            Session.Saving = false;
        }
        StoredAspectCleanup.ClearEmptied(Application, Session.EmptiedAspects);
        Session.Saved();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }, "Saved, reloading");

    // Text that is no value of its type, a calculator that throws, a failed save: reported, not thrown into the circuit.
    void Run(Action action, string? done) {
        try {
            // A save of this user's model from elsewhere removed the nodes added here (ModelEditorController).
            if (selected is not null && !ModelEditing.IsInModel(selected)) {
                selected = null;
                throw new InvalidOperationException("Your model was saved elsewhere, which removed the nodes added here. Select a node.");
            }
            action();
            message = done;
        }
        catch (Exception ex) {
            message = ex.Message;
            refusals++;
        }
    }
}
