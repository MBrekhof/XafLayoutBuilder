<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- MODELEDITOR-001 spike: a runtime Model Editor for XAF Blazor. Not a package until the spike's verdict says so. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.ExpressApp.Blazor" Version="$(DevExpressPackageRange)" />
    <!-- DevExpress.ExpressApp.Blazor pulls in 9.0.0, which has known vulnerabilities (NU1903); pin the patched line. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" NoWarn="NU1510" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XafLayoutBuilder.Tests" />
  </ItemGroup>
</Project>
